# TourneyRadar — environment variables
# Copy this file: cp .env.local.example .env.local
# Fill in your own values. Never commit .env.local.

# ── Required: Supabase ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — scraper needs this to upsert to Supabase
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Optional: Site & Deployment ──────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://www.tourneyradar.com

# ── Optional: Analytics (PostHog, Umami, Google Analytics) ───────────────────
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-token
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_ASSETS_HOST=https://eu-assets.i.posthog.com
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
# UMAMI_SCRIPT_HOST=https://cloud.umami.is
# UMAMI_GATEWAY_HOST=https://api-gateway.umami.dev
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Optional: Google Maps ───────────────────────────────────────────────────
# Used by the scraper for geocoding tournament locations
# Leave empty or commented out to skip geocoding (lat/lng will be null)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Optional: Resend Email ───────────────────────────────────────────────────
# Server-side only — weekly digest email job (scripts/send-digest.ts) needs this
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_ADDRESS=TourneyRadar <digest@tourneyradar.com>

# ── Optional: Cron ──────────────────────────────────────────────────────────
# Server-side only — protects automated cron route endpoints
# CRON_SECRET=your-cron-secret
