# TourneyRadar — environment variables
# Copy this file: cp .env.local.example .env.local
# Fill in your own values. Never commit .env.local.
#
# To run `npm run dev` you only need the two Supabase variables under
# "Required". Everything else is optional: lines that start with # can stay
# commented out and the app falls back to its defaults.

# ── Required ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase, server side ───────────────────────────────────────────────────
# Server-side only — scraper needs this to upsert to Supabase. The digest and
# dataset scripts and a few API routes read it too.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Maps ─────────────────────────────────────────────────────────────
# Used by the scraper for geocoding tournament locations
# Leave empty to skip geocoding (lat/lng will be null)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Resend ──────────────────────────────────────────────────────────────────
# Server-side only — weekly digest email job (scripts/send-digest.ts) needs this
RESEND_API_KEY=your-resend-api-key
# Optional: verified sender identity. Defaults to a placeholder if unset.
RESEND_FROM_ADDRESS=TourneyRadar <digest@tourneyradar.com>

# ── Site URL ────────────────────────────────────────────────────────────────
# Base URL used for absolute links in the calendar feed, country pages and the
# digest email. Defaults to https://www.tourneyradar.com when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cron and revalidation ───────────────────────────────────────────────────
# Bearer token for /api/cron/scrape-tournaments and /api/revalidate. Leave
# unset locally: /api/revalidate then answers 503 as "not configured".
# CRON_SECRET=

# ── Analytics (optional) ────────────────────────────────────────────────────
# These belong to the project's own accounts. Contributors do not need them:
# without a token the app logs a console warning in development and sends no
# events.
# PostHog. The host defaults to https://eu.i.posthog.com and the assets host is
# derived from it.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_ASSETS_HOST=https://eu-assets.i.posthog.com
# Umami. The script is only added when the website id is set.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_HOST=https://cloud.umami.is
# UMAMI_GATEWAY_HOST=https://gateway.umami.is
# Google Analytics. Only loaded when the measurement id is set.
# NEXT_PUBLIC_GA_ID=
