{
  "name": "TourneyRadar",
  "version": "3.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "scrape": "npx tsx --env-file=.env.local scripts/scrape.ts",
    "scrape:ci": "npx tsx scripts/scrape.ts",
    "scrape:region": "npx tsx scripts/scrape.ts",
    "digest": "npx tsx --env-file=.env.local scripts/send-digest.ts",
    "digest:ci": "npx tsx scripts/send-digest.ts",
    "export:dataset": "npx tsx --env-file=.env.local scripts/export-dataset.ts",
    "export:dataset:ci": "npx tsx scripts/export-dataset.ts",
    "test:e2e": "playwright test",
    "demo:gif": "node scripts/record-demo.mjs",
    "test:rls": "node --test supabase/tests/rls.test.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "@vercel/analytics": "^2.0.1",
    "cheerio": "^1.2.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^16.4.2",
    "posthog-js": "^1.438.12",
    "puppeteer": "^25.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/cheerio": "^1.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6"
  }
}
